# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Never put AWS keys in here - use `aws configure`, AWS_PROFILE or environment variables instead.
aws_region         = "ap-south-1"
cluster_name       = "foundit-eks"
cluster_version    = "1.34"
environment        = "dev"
node_instance_type = "t3.medium"
node_count         = 2
# Only your IP may reach the Kubernetes API. Find it with: curl -s https://checkip.amazonaws.com
api_allowed_cidrs = ["203.0.113.10/32"]
